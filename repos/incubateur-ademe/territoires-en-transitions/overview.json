{
  "url": "https://github.com/incubateur-ademe/territoires-en-transitions",
  "name": "territoires-en-transitions",
  "description": "Plateforme numérique destinée aux collectivités territoriales pour faciliter et accélérer la mise en œuvre d'actions de transition écologique. Elle permet de prioriser les actions à fort impact et de suivre les indicateurs de transition.",
  "language": "TypeScript",
  "features": [
    "Visualisation de données & Cartographie",
    "Statistiques & Rapports",
    "Recherche & Filtres",
    "Gestion des utilisateurs & Permissions",
    "Formulaires & Démarches",
    "Données & Schémas",
    "Interface utilisateur & Design",
    "Suivi & Traçabilité"
  ],
  "audience": "Agents de l'Administration",
  "dependencies": [
    "React",
    "Next.js",
    "NestJS",
    "Supabase",
    "PostgreSQL",
    "TypeScript",
    "Tailwind CSS",
    "Playwright",
    "Nx",
    "pnpm",
    "Python",
    "Redis",
    "Strapi"
  ],
  "components": [
    "API REST & GraphQL",
    "PostgreSQL & SQL",
    "React / Next.js",
    "TypeScript / JavaScript",
    "Python (scripts & backend)",
    "Design System (DSFR & UI libs)",
    "Docker & Conteneurs",
    "Node.js / NestJS",
    "CMS (Strapi, Wagtail…)",
    "Authentification (composant)",
    "SIG & Géospatial"
  ],
  "auth": {
    "methods": [
      "oauth2",
      "jwt",
      "session"
    ],
    "providers": [
      "ProConnect",
      "MonCompteAdeme"
    ]
  },
  "tests": [
    "Playwright",
    "Vitest",
    "pgTAP"
  ],
  "workflows": [
    "test-db-deploy.yml"
  ],
  "status": "maintained",
  "license": "ISC",
