{
  "url": "https://github.com/incubateur-ademe/territoires-en-transitions",
  "name": "territoires-en-transitions",
  "description": "Plateforme numérique conçue pour aider les collectivités territoriales à prioriser et suivre la mise en œuvre d'actions de transition écologique impactantes.",
  "language": "TypeScript",
  "features": [
    "Visualisation de données & Cartographie",
    "Statistiques & Rapports",
    "Recherche & Filtres",
    "Gestion des utilisateurs & Permissions",
    "Formulaires & Démarches",
    "Suivi & Traçabilité",
    "Interface utilisateur & Design"
  ],
  "audience": "Agents de l'Administration",
  "dependencies": [
    "React",
    "Next.js",
    "Supabase",
    "PostgreSQL",
    "NestJS",
    "TypeScript",
    "Tailwind CSS",
    "Redis",
    "Strapi",
    "Playwright",
    "Vitest",
    "Leaflet",
    "Nivo"
  ],
  "components": [
    "React / Next.js",
    "TypeScript / JavaScript",
    "API REST & GraphQL",
    "PostgreSQL & SQL",
    "Docker & Conteneurs",
    "Node.js / NestJS",
    "Design System (DSFR & UI libs)",
    "SIG & Géospatial",
    "CMS (Strapi, Wagtail…)",
    "CI/CD & Déploiement"
  ],
  "auth": {
    "methods": [
      "oauth2",
      "jwt",
      "session"
    ],
    "providers": [
      "ProConnect",
      "MonCompteAdeme"
    ]
  },
  "tests": [
    "Playwright",
    "Vitest",
    "pgTAP",
    "NestJS testing"
  ],
  "workflows": [
    "GitHub Actions"
  ],
  "status": "maintained",
  "license": "ISC",
  "hasDocumentation": true,
  "tags": [
    "Territoire & Collectivités",
    "Environnement & Énergie",
    "React & Next.js",
    "TypeScript",
    "Docker & Conteneurs",
    "SIG & Géospatial",
    "Données & Open Data"
  ]
}
