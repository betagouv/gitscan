    "React",
    "Next.js",
    "NestJS",
    "Supabase",
    "PostgreSQL",
    "Redis",
    "Strapi",
    "TypeScript",
    "Python",
    "Playwright",
    "TailwindCSS",
    "pnpm"
  ],
  "components": [
    "API REST & GraphQL",
    "PostgreSQL & SQL",
    "React / Next.js",
    "TypeScript / JavaScript",
    "Python (scripts & backend)",
    "Docker & Conteneurs",
    "Node.js / NestJS",
    "CMS (Strapi, Wagtail…)",
    "Authentification (composant)",
    "SIG & Géospatial",
    "Tests"
  ],
  "auth": {
