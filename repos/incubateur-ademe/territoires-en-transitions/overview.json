{
  "url": "https://github.com/incubateur-ademe/territoires-en-transitions",
  "name": "territoires-en-transitions",
  "description": "Plateforme numérique destinée à aider les collectivités territoriales à prioriser et à mettre en œuvre des actions de transition écologique à fort impact.",
  "language": "TypeScript",
  "features": [
    "Visualisation de données & Cartographie",
    "Statistiques & Rapports",
    "Gestion métier générale",
    "Collaboration & Workflow",
    "Données & Schémas"
  ],
  "audience": "Agents de l'Administration",
  "dependencies": [
    "React",
    "Next.js",
    "NestJS",
    "Supabase",
    "PostgreSQL",
    "Redis",
    "Strapi",
    "Python",
    "Playwright",
    "Vitest"
  ],
  "components": [
    "React / Next.js",
    "API REST & GraphQL",
    "PostgreSQL & SQL",
    "TypeScript / JavaScript",
    "Python (scripts & backend)",
    "Docker & Conteneurs",
    "CMS (Strapi, Wagtail…)",
    "Tests"
  ],
  "auth": {
    "methods": [
      "oauth2",
      "jwt",
      "session"
    ],
    "providers": [
      "ProConnect",
      "MonCompteAdeme"
    ]
  },
  "tests": [
    "Playwright",
    "Vitest",
    "pgTAP",
    "Nx"
  ],
  "workflows": [
    "GitHub Actions"
  ],
  "status": "maintained",
  "license": "ISC",
  "hasDocumentation": true,
  "tags": [
    "Territoire & Collectivités",
    "Environnement & Énergie",
    "React & Next.js",
    "TypeScript",
    "Docker & Conteneurs",
    "Données & Open Data",
    "Écosystème beta.gouv / État"
  ]
}
