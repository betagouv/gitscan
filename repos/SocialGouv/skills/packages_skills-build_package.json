{
  "name": "skills-build",
  "version": "1.0.0",
  "description": "Build tooling for compiling individual rule files into AGENTS.md",
  "type": "module",
  "scripts": {
    "build": "pnpm build-agents && pnpm extract-tests",
    "build-agents": "tsx src/build.ts",
    "build-all": "tsx src/build.ts --all",
    "build-rgaa": "tsx src/build.ts --skill=rgaa-html-css",
    "validate": "tsx src/validate.ts",
    "validate-rgaa": "tsx src/validate.ts --skill=rgaa-html-css",
    "extract-tests": "tsx src/extract-tests.ts",
    "dev": "pnpm build && pnpm validate"
  },
  "keywords": [
    "skills",
    "agents",
    "build-tools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
