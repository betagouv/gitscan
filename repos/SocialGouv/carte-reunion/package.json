{
  "name": "carte-reunion",
  "version": "0.1.0",
  "private": true,
  "description": "Carte partagée d'une réunion Visio, proposée par un LLM et validée par les participants",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "replay": "node --env-file-if-exists=.env scripts/replay.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
