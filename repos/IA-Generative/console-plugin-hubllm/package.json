{
  "name": "@cpn-console/hubllm-plugin",
  "type": "module",
  "version": "0.1.2",
  "description": "HubLLM plugin for DSO console",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "nodemon --watch src --ext .ts --exec 'npm run build'",
    "build": "tsc",
    "build:clean": "rm -rf ./dist ./types ./tsconfig.tsbuildinfo",
    "format": "eslint ./src --fix",
    "lint": "eslint ./src",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "dependencies": {
    "@cpn-console/hooks": "^4.0.0",
    "axios": "^1.13.2",
    "js-yaml": "4.1.0",
    "uuid": "^11.1.0",
    "yaml-edit": "^0.1.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@cpn-console/eslint-config": "^1.0.2",
    "@cpn-console/shared": "^1.3.0",
    "@cpn-console/ts-config": "^1.1.0",
    "@types/node": "^25.0.10",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3",
    "typescript-transform-paths": "^3.5.5"
  }
}
