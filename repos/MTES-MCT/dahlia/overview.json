{
  "url": "https://github.com/MTES-MCT/dahlia",
  "name": "dahlia",
  "description": "Application d'aide à l'organisation des défenses des dossiers DALO, DAHO et DAHU. Elle permet de centraliser et de gérer les dossiers de contentieux liés au droit au logement pour les départements.",
  "language": "TypeScript",
  "features": [
    "Authentification & Accès",
    "Recherche & Filtres",
    "Suivi & Traçabilité",
    "Gestion métier générale"
  ],
  "audience": "Agents de l'Administration",
  "dependencies": [
    "Next.js",
    "PostgreSQL",
    "Prisma",
    "better-auth",
    "@codegouvfr/react-dsfr",
    "Vitest"
  ],
  "components": [
    "React / Next.js",
    "TypeScript / JavaScript",
    "PostgreSQL & SQL",
    "ORM & Accès aux données",
    "Docker & Conteneurs",
    "Authentification (composant)",
    "Pipeline de données",
    "Design System (DSFR & UI libs)"
  ],
  "auth": {
    "methods": [
      "oauth2",
      "jwt",
      "session"
    ],
    "providers": [
      "ProConnect"
    ]
  },
  "tests": "Vitest",
  "status": "maintained",
  "hasDocumentation": true,
  "tags": [
    "React & Next.js",
    "TypeScript",
    "Bases de données SQL",
    "Docker & Conteneurs",
    "Design System & UI",
    "ETL & Pipelines de données"
  ]
}
